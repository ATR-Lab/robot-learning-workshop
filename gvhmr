#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "$0")" && pwd)"
source "$ROOT/scripts/python-env.sh"
if ! is_python312 "$ROOT/.venv/bin/python" || [[ ! -x "$ROOT/.venv/bin/gvhmr" ]]; then
    echo 'Run ./setup.sh first (or rerun it to repair the GVHMR environment).' >&2
    exit 1
fi
exec "$ROOT/.venv/bin/gvhmr" "$@"
