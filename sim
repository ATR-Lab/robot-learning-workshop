#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "$0")" && pwd)"
source "$ROOT/scripts/python-env.sh"

if [[ "${1:-}" == --docker ]]; then
    shift
    cd "$ROOT"
    command -v docker >/dev/null || { echo 'Install Docker and Compose first.' >&2; exit 1; }
    if [[ "${1:-}" == setup ]]; then
        exec docker compose build sim
    fi
    ports=()
    if [[ "${1:-}" == play && " $* " != *' --check '* && " $* " != *' --record '* ]]; then
        ports=(--service-ports)
    fi
    exec docker compose run --rm "${ports[@]}" sim "$@"
fi

if [[ "${1:-}" == setup ]]; then
    select_python312
    ensure_python312_env "$ROOT/.venv-sim"
    "$ROOT/.venv-sim/bin/python" -m pip install -r "$ROOT/requirements/sim.txt"
    "$ROOT/.venv-sim/bin/python" -m pip check
    "$ROOT/.venv-sim/bin/python" "$ROOT/scripts/prepare_policy.py" --assets
    echo 'Ready. Run: ./sim play /path/to/policy.onnx'
    exit 0
fi

if [[ -x "$ROOT/.venv-sim/bin/python" ]]; then
    is_python312 "$ROOT/.venv-sim/bin/python" || { echo 'Run ./setup.sh again to repair the MuJoCo environment (Python 3.12 required).' >&2; exit 1; }
    exec "$ROOT/.venv-sim/bin/python" "$ROOT/scripts/sim.py" "$@"
elif [[ "${1:-}" == import || "${1:-}" == pack || "${1:---help}" == --help ]]; then
    exec python3 "$ROOT/scripts/sim.py" "$@"
else
    echo 'Run ./sim setup first, or use ./sim --docker setup.' >&2
    exit 1
fi
