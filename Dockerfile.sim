# CPU MuJoCo + ONNX, independent of the NVIDIA motion-recovery image.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libegl1 libgl1 libglfw3 libglib2.0-0 libosmesa6 && rm -rf /var/lib/apt/lists/*
COPY requirements/sim.txt /opt/sim-requirements.txt
RUN pip install --no-cache-dir -r /opt/sim-requirements.txt && pip check
WORKDIR /workspace
COPY scripts/sim.py scripts/play_mujoco.py /workspace/scripts/
ENV SIM_DOCKER=1 MUJOCO_GL=egl PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "/workspace/scripts/sim.py"]
CMD ["--help"]
